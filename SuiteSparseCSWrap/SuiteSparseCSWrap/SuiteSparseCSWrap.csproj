<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>SuiteSparseCSWrap</RootNamespace>
    <AssemblyName>SuiteSparseCSWrapper</AssemblyName>

    <!-- Prevent framework subfolders in output -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Configurations -->
    <Configurations>Debug;Release</Configurations>
    <Platforms>x86;AnyCPU</Platforms>
  </PropertyGroup>

  <!-- Debug|x86 Configuration -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>bin\Debug\SuiteSparseCSWrapper.XML</DocumentationFile>
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Release|x86 Configuration -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>bin\Release\SuiteSparseCSWrapper.XML</DocumentationFile>
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Debug|AnyCPU Configuration -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>bin\Debug\SuiteSparseCSWrapper.XML</DocumentationFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Release|AnyCPU Configuration -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>bin\Release\SuiteSparseCSWrapper.XML</DocumentationFile>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>KalininEI</Company>
    <Product>SuiteSparseCSWrapper</Product>
  </PropertyGroup>


    <PropertyGroup>
      <TargetFramework>net48</TargetFramework>
      <OutputType>Library</OutputType>
      <AppDesignerFolder>Properties</AppDesignerFolder>
      <RootNamespace>SuiteSparseCSWrap</RootNamespace>
      <AssemblyName>SuiteSparseCSWrapper</AssemblyName>

      <!-- NuGet Packaging Settings -->
      <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
      <PackageId>SuiteSparseCSWrapper</PackageId>
      <Version>1.0.0</Version>
      <Authors>KalininEI</Authors>
      <Description>SuiteSparse wrapper for .NET</Description>
      <PackageTags>suitesparse;sparse-matrix;linear-algebra</PackageTags>

      <!-- Include native DLLs in package -->
      <IncludeBuildOutput>true</IncludeBuildOutput>
      <IncludeContentInPack>true</IncludeContentInPack>

      <!-- Output Settings -->
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
      <PackageOutputPath>..\..\..\NuGetPackages</PackageOutputPath>
    </PropertyGroup>

    <!-- Add native DLLs to the package -->
  <!-- Include ALL required native DLLs -->
  <ItemGroup>
    <!-- x64 Dependencies -->
    <None Include="..\..\winlib\lib64\*.dll" Pack="true" PackagePath="runtimes\win-x64\native" />

    <!-- x86 Dependencies -->
    <None Include="..\..\winlib\lib\*.dll" Pack="true" PackagePath="runtimes\win-x86\native" />

    <!-- Add targets file -->
    <None Include="SuiteSparseCSWrapper.targets"
      Pack="true"
      PackagePath="build\$(TargetFramework)" />
  </ItemGroup>
</Project>